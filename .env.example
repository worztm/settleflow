# SettleFlow Environment Variables
# Copy this file to .env and fill in your values

# API URL — points to your Cloudflare Worker in production
# In dev, Vite proxies /api to the worker (see vite.config.ts)
VITE_API_URL=/api

# OpenClawCash API (optional — for wallet operations)
VITE_OPENCLAW_API_KEY=occ_your_api_key_here
VITE_OPENCLAW_URL=https://openclawcash.com